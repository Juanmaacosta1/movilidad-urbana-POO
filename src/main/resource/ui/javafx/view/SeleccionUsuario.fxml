<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="md.ui.impl.javafx.controller.SeleccionUsuarioController"
           styleClass="page" prefWidth="520" prefHeight="520">
    <stylesheets>
        <URL value="@../css/estilos.css"/>
        <URL value="@../css/pantallas.css"/>
    </stylesheets>

    <VBox alignment="CENTER" maxWidth="440" spacing="14" StackPane.alignment="CENTER">
        <HBox alignment="CENTER_RIGHT" spacing="8"><Label text="%text.language"/><ComboBox fx:id="cmbIdioma" onAction="#cambiarIdioma" prefWidth="125"/></HBox>
        <Label text="%text.091" styleClass="titulo-grande"/>
        <Label text="%text.092" styleClass="subtitulo" wrapText="true"/>

        <VBox styleClass="card" spacing="10">
            <Label text="%text.093" styleClass="field-label"/>
            <ComboBox fx:id="cmbUsuario" maxWidth="Infinity" promptText="%text.094"
                      onAction="#usuarioElegido"/>
            <Label fx:id="lblRoles" text="%text.095"
                   styleClass="hint-label" wrapText="true"/>
            <Label fx:id="lblDetalle" text="%text.096"
                   styleClass="hint-label" wrapText="true"/>

            <Button fx:id="btnCliente" text="%text.097" onAction="#entrarComoCliente"
                    maxWidth="Infinity" styleClass="button-primary" disable="true"/>
            <Button fx:id="btnConductor" text="%text.098" onAction="#entrarComoConductor"
                    maxWidth="Infinity" styleClass="button-secondary" disable="true"/>

            <Label fx:id="lblMensaje" styleClass="mensaje-error" wrapText="true"/>
        </VBox>
    </VBox>
</StackPane>