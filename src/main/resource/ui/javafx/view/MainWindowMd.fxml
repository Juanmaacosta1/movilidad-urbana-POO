<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="md.ui.impl.javafx.controller.MiniController"
            stylesheets="@../css/estilos.css"
            fitToWidth="true" prefWidth="440" prefHeight="620">
    <content>
        <VBox styleClass="page" spacing="10">

        <!-- Pasajero -->
            <VBox styleClass="card" spacing="10">
                <Label text="¿Quién viaja?" styleClass="field-label"/>
                <ComboBox fx:id="cmbPasajero" maxWidth="Infinity" promptText="Elegí un pasajero"/>
                <Label fx:id="lblResultado" text="Elegí quién va a viajar." wrapText="true"/>
            </VBox>

            <!-- Mapa -->
            <VBox styleClass="card" spacing="10">
                <Label text="Seleccioná el origen y el destino" styleClass="field-label"/>
                <Button fx:id="btnElegirOrigen" text="Elegir origen en el mapa"
                        onAction="#seleccionarOrigen" maxWidth="Infinity" disable="true"/>
                <Label fx:id="lblOrigen" text="Origen: sin seleccionar" wrapText="true"/>
                <Button fx:id="btnElegirDestino" text="Elegir destino en el mapa"
                        onAction="#seleccionarDestino" maxWidth="Infinity" disable="true"/>
                <Label fx:id="lblDestino" text="Destino: sin seleccionar" wrapText="true"/>
                <Label fx:id="lblEstadoMapa" text="Cargando mapa..." wrapText="true"/>
                <WebView fx:id="mapa" prefHeight="300" minHeight="250"/>
            </VBox>
            <!-- Servicio -->
            <VBox styleClass="card" spacing="10">
                <Label text="¿Qué servicio necesitás?" styleClass="field-label"/>
                <ComboBox fx:id="cmbTipoServicio" maxWidth="Infinity" promptText="Elegí un servicio"
                          onAction="#seleccionarServicio"/>
                          <Button text="Solicitar viaje" onAction="#solicitarViaje"
                        maxWidth="Infinity" styleClass="button-primary"/>
                <Label fx:id="lblResultadoServicio" text="Elegí un servicio disponible." wrapText="true"/>
            </VBox>

            <!-- Chofer -->
            <VBox styleClass="card" spacing="10">
                <Label text="¿Quién conduce?" styleClass="field-label"/>
                <ComboBox fx:id="cmbChofer" maxWidth="Infinity" promptText="Elegí un conductor"/>
                <Button text="Seleccionar conductor" onAction="#solicitarChofer"
                        maxWidth="Infinity" styleClass="button-primary"/>
                <Label fx:id="lblResultadoChofer" text="Elegí un conductor disponible." wrapText="true"/>
            </VBox>

            <!-- Admin -->
            <Button fx:id="btnAdministracion" text="Administrar usuarios y conductores"
                    onAction="#alternarAdministracion" maxWidth="Infinity"/>
            <VBox fx:id="seccionAdministracion" spacing="10" visible="false" managed="false">
                <VBox styleClass="card" spacing="10">
                    <Label text="Administración de usuarios" styleClass="field-label"/>
                    <ComboBox fx:id="cmbUsuarios" maxWidth="Infinity" promptText="Buscar usuario"/>
                    <Button text="Seleccionar usuario" onAction="#solicitarUsuario"
                            maxWidth="Infinity" styleClass="button-primary"/>
                    <Label fx:id="lblResultadoUsuario" text="Elegí un usuario disponible." wrapText="true"/>
                </VBox>
                <VBox styleClass="card" spacing="10">
                    <Label text="Administración de conductores" styleClass="field-label"/>
                    <ComboBox fx:id="cmbConductoresAdmin" maxWidth="Infinity" promptText="Buscar conductor"/>
                    <Button text="Seleccionar conductor" onAction="#solicitarConductorAdmin"
                            maxWidth="Infinity" styleClass="button-primary"/>
                    <Label fx:id="lblResultadoConductorAdmin" text="Elegí un conductor registrado." wrapText="true"/>
                </VBox>
            </VBox>

        </VBox>
    </content>
</ScrollPane>